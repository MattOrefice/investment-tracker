# FRED API key — free at https://fredaccount.stlouisfed.org/apikeys
# Required for the Macro dashboard (CAPE, yield curve, credit spreads)
FRED_API_KEY=your_32_character_hex_key_here

# Portfolio mode: "personal" (local tracker.db) or "demo" (demo.db)
# Defaults to "demo" if unset or unrecognised — personal mode must be asked for
# explicitly, so that a missing/typo'd value can never expose real holdings or
# enable writes on the public Cloud deployment.
TRACKER_MODE=personal
